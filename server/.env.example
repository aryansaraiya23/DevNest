# Server Environment Template
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/devnest?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/devnest?retryWrites=true&w=majority

# Strong random secret key for signing JWT cookies (minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# OnlineCompiler.io Code Execution API Key (kept server-side, never exposed to client)
ONLINECOMPILER_API_KEY=your_onlinecompiler_api_key_here
ONLINECOMPILER_BASE_URL=https://api.onlinecompiler.io
